{
  "name": "cbz-sorter-v5",
  "version": "5.0.0",
  "description": "CBZ comic file sorter with built-in viewer",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json && electron .",
    "dev": "concurrently -n renderer,main \"npm run dev:renderer\" \"wait-on http://localhost:5210 && npm run dev:main\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.17",
    "extract-zip": "^2.0.1",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/adm-zip": "^0.5.8",
    "@types/extract-zip": "^2.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "wait-on": "^9.0.5"
  }
}
